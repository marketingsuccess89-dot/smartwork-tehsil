# ==============================================================================
# SMART TYPING - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env or add these in Hugging Face Spaces -> Settings -> Secrets
# ==============================================================================

# 1. Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (Database & 1-Click Google Auth)
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 3. Cloudflare R2 Storage (10 GB Free Storage for DOCX / PDF files)
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CF_R2_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CF_R2_BUCKET_NAME=smartwork-docs
CF_R2_PUBLIC_DOMAIN=https://your-custom-r2-subdomain.r2.dev

# 4. Razorpay Payment Gateway (₹49 Weekly, ₹99 Monthly, ₹999 Yearly)
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id_or_test_key
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 5. Server Settings
PORT=7860
